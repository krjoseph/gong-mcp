# Gong API Credentials
GONG_ACCESS_KEY=your_access_key_here
GONG_ACCESS_SECRET=your_access_secret_here

# Optional: Custom Gong API URL
# GONG_API_URL=https://api.gong.io/v2

# Transport Configuration
# MCP_TRANSPORT=stdio          # Default: stdio transport for CLI/local use
# MCP_TRANSPORT=streamable-http # HTTP transport for web deployments

# HTTP Server Configuration (only used when MCP_TRANSPORT=streamable-http)
# PORT=3000
# HOST=127.0.0.1
